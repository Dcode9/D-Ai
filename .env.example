# D'Ai Server Environment Variables
# Copy to .env.local and fill in real values.
# In Vercel, set these in the project Settings -> Environment Variables.

# ----- AI Provider API Keys (at least one is required) -----
# Groq — primary provider for fast chat + vision
GROQ_API_KEY=

# Inception Labs — fast Mercury-2 text model
INCEPTION_API=

# Cloudflare Workers AI — image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face — image generation fallback
HUGGINGFACE_API_KEY=

# ----- Web Search -----
# Optional: Tavily API key for higher-quality web search results
WEB_SEARCH_API=

# ----- Pollinations (interface generation) -----
POLLINATIONS_API=

# ----- Storage (Vercel Blob) -----
# Required if you want server-side image upload (otherwise local-only fallback)
BLOB_READ_WRITE_TOKEN=

# ----- Security -----
# Set to your domain in production to lock down CORS. Leave blank or '*' for dev.
ALLOWED_ORIGIN=

# ----- Frontend Config (injected at runtime, optional) -----
# Override the default Supabase project for cloud chat sync.
# In production you should set both to your own Supabase project.
# These are read in scripts/dverseClient.js
#   window.DVERSE_SUPABASE_URL
#   window.DVERSE_SUPABASE_KEY
#   window.DVERSE_PORTAL_ORIGIN
